---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% comment %}
  Generated by Jekyll at every build. Public HTML pages and every output
  collection (including future posts, articles or case studies) are discovered
  automatically. Set `noindex: true` or `sitemap: false` in a document's front
  matter to keep it out of this file.
{% endcomment %}
{% for collection in site.collections %}
  {% if collection.output %}
    {% for doc in collection.docs %}
      {% unless doc.sitemap == false or doc.noindex == true or doc.redirect_to %}
  <url>
    <loc>{{ doc.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
        {% if doc.last_modified_at or doc.date %}
    <lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
        {% endif %}
  </url>
      {% endunless %}
    {% endfor %}
  {% endif %}
{% endfor %}
{% for page in site.html_pages %}
  {% unless page.sitemap == false or page.noindex == true or page.redirect_to or page.url == '/404.html' or page.url == '/sitemap.xml' %}
  <url>
    <loc>{{ page.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
    {% if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
  {% endunless %}
{% endfor %}
</urlset>
